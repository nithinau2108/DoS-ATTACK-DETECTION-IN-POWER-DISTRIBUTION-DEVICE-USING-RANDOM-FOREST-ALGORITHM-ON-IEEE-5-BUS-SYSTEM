clear; clc;

BASE_KV  = 11;
BASE_MVA = 100;
Zbase = BASE_KV^2 / BASE_MVA;

tol = 1e-8; maxIter = 100;

busDataRaw = [
    1     0     0;
    2   890   468;
    3   628   470;
    4  1112   764;
    5   636   378;
    6   474   344;
    7  1342  1078;
    8   920   292;
    9   766   498;
    10  662   480;
    11  690   186;
    12 1292   554;
    13 1124   480];

nbus  = size(busDataRaw,1);
slack = 1;
pq    = 2:nbus;

Pspec0 = -busDataRaw(:,2) / (1000*BASE_MVA);   % kW -> pu (negative = load)
Qspec0 = -busDataRaw(:,3) / (1000*BASE_MVA);   % kVAr -> pu
Pspec0(slack) = 0; Qspec0(slack) = 0;
lineRaw = [
    1  2  0.176 0.138;
    2  3  0.176 0.138;
    3  4  0.045 0.035;
    4  5  0.089 0.069;
    5  6  0.045 0.035;
    5  7  0.116 0.091;
    7  8  0.073 0.073;
    8  9  0.074 0.058;
    8  10 0.093 0.093;
    7  11 0.063 0.050;
    11 12 0.068 0.053;
    7  13 0.062 0.053];

lineData = lineRaw;
lineData(:,3) = lineRaw(:,3) / Zbase;   % R -> pu
lineData(:,4) = lineRaw(:,4) / Zbase;   % X -> pu
lineData(:,5) = 0;                       % no line charging susceptance given

Ybus0 = buildYbus(nbus, lineData);
G0 = real(Ybus0); B0 = imag(Ybus0);
[V0, d0, ok0] = runNR(G0, B0, Pspec0, Qspec0, pq, slack, tol, maxIter);
if ~ok0
    error('Base case power flow did not converge - check base kV/MVA assumptions.');
end
fprintf('Base case converged. Voltage range: %.4f - %.4f pu\n', min(V0), max(V0));
numSamples = 10000;
rng(42);
results = cell(numSamples,1);
sampleID = 0; k = 0;

fprintf('Generating %d samples for IEEE 13-bus system...\n', numSamples);
while k < numSamples
    scale = 0.70 + 0.60*rand();
    Pspec = Pspec0 * scale; Pspec(slack) = 0;
    Qspec = Qspec0 * scale; Qspec(slack) = 0;
    [V, delta, converged] = runNR(G0, B0, Pspec, Qspec, pq, slack, tol, maxIter);
    if ~converged
        continue
    end
    P = calcP(V, delta, G0, B0);
    Q = calcQ(V, delta, G0, B0);

    Vn = V + 0.003*randn(size(V));
    dn = delta + deg2rad(0.05)*randn(size(delta));
    Pn = P + (0.5/BASE_MVA)*randn(size(P));
    Qn = Q + (0.3/BASE_MVA)*randn(size(Q));
glitchCount = 0;
    if rand() < 0.04
        b = randi(nbus);
        Vn(b) = NaN; dn(b) = NaN; Pn(b) = NaN; Qn(b) = NaN;
        glitchCount = 1;
    end

    % ---- Hidden attack-intensity model (drives the label) ----
    isRecovery = rand() < 0.15;
    if ~isRecovery
        intensity = rand();
        label = min(floor(intensity/0.25), 3);
        packet_delay = intensity + 0.06*randn();
        packet_loss  = 0.9*intensity + 0.06*randn();
        % ~15% low-and-slow DoS: elevated delay/loss but glitchCount stays as-is
    else
        recoveryProg = rand();
        label = 4;
        packet_delay = 0.30 + 0.40*(1-recoveryProg) + 0.06*randn();
        packet_loss  = 0.05*(1-recoveryProg)         + 0.03*randn();
    end
    packet_delay = min(max(packet_delay,0),1);
    packet_loss  = min(max(packet_loss,0),1);

    sampleID = sampleID + 1;
    k = k + 1;
    results{sampleID} = buildRow(sampleID, label, Vn, dn, Pn, Qn, BASE_MVA, ...
                                  packet_delay, packet_loss, glitchCount, nbus);
end
results = results(~cellfun(@isempty, results));
T = vertcat(results{:});
T = T(randperm(height(T)), :);

classNames = {'Normal','Low_DoS','Medium_DoS','High_DoS','Recovery'};
Ycheck = categorical(T.Label, [0 1 2 3 4], classNames);
tab = countcats(Ycheck);
fprintf('\nClass counts:\n');
for i = 1:numel(classNames)
    fprintf('  %-12s : %d\n', classNames{i}, tab(i));
end

outFile = 'IEEE13Bus_DoS_dataset.xlsx';
writetable(T, outFile);
fprintf('\nDataset saved to: %s (%d rows, %d columns)\n', outFile, height(T), width(T));


%% =================================================================
%                         LOCAL FUNCTIONS
%  =================================================================
function Ybus = buildYbus(nbus, lineData)
    Ybus = zeros(nbus, nbus);
    for k = 1:size(lineData,1)
        i = lineData(k,1); j = lineData(k,2);
        r = lineData(k,3); x = lineData(k,4); bHalf = lineData(k,5);
        y = 1/(r + 1i*x);
        Ybus(i,i) = Ybus(i,i) + y + 1i*bHalf;
        Ybus(j,j) = Ybus(j,j) + y + 1i*bHalf;
        Ybus(i,j) = Ybus(i,j) - y;
        Ybus(j,i) = Ybus(j,i) - y;
    end
end
function P = calcP(V, delta, G, B)
    nbus = numel(V); P = zeros(nbus,1);
    for i = 1:nbus
        s = 0;
        for j = 1:nbus
            s = s + V(j)*(G(i,j)*cos(delta(i)-delta(j)) + B(i,j)*sin(delta(i)-delta(j)));
        end
        P(i) = V(i)*s;
    end
end
function Q = calcQ(V, delta, G, B)
    nbus = numel(V); Q = zeros(nbus,1);
    for i = 1:nbus
        s = 0;
        for j = 1:nbus
            s = s + V(j)*(G(i,j)*sin(delta(i)-delta(j)) - B(i,j)*cos(delta(i)-delta(j)));
        end
        Q(i) = V(i)*s;
    end
end
function J = buildJacobian(V, delta, G, B, P, Q, pq)
    npq = numel(pq);
    J11 = zeros(npq,npq); J12 = zeros(npq,npq);
    J21 = zeros(npq,npq); J22 = zeros(npq,npq);
    for a = 1:npq
        i = pq(a);
        for c = 1:npq
            kk = pq(c);
            if i ~= kk
                ang = delta(i) - delta(kk);
                J11(a,c) =  V(i)*V(kk)*(G(i,kk)*sin(ang) - B(i,kk)*cos(ang));
                J12(a,c) =  V(i)*(G(i,kk)*cos(ang) + B(i,kk)*sin(ang));
                J21(a,c) = -V(i)*V(kk)*(G(i,kk)*cos(ang) + B(i,kk)*sin(ang));
                J22(a,c) =  V(i)*(G(i,kk)*sin(ang) - B(i,kk)*cos(ang));
            else
                J11(a,c) = -Q(i) - V(i)^2*B(i,i);
                J12(a,c) =  P(i)/V(i) + V(i)*G(i,i);
                J21(a,c) =  P(i) - V(i)^2*G(i,i);
                J22(a,c) =  Q(i)/V(i) - V(i)*B(i,i);
            end
        end
    end
    J = [J11 J12; J21 J22];
end
function [V, delta, converged] = runNR(G, B, Pspec, Qspec, pq, slack, tol, maxIter)
    nbus = size(G,1);
    V = ones(nbus,1); delta = zeros(nbus,1);
    converged = false; npq = numel(pq);
    for iter = 1:maxIter
        P = calcP(V, delta, G, B);
        Q = calcQ(V, delta, G, B);
        mismatch = [Pspec(pq)-P(pq); Qspec(pq)-Q(pq)];
        if max(abs(mismatch)) < tol
            converged = true; break
        end
        J = buildJacobian(V, delta, G, B, P, Q, pq);
        dx = J \ mismatch;
        delta(pq) = delta(pq) + dx(1:npq);
        V(pq)     = V(pq)     + dx(npq+1:end);
    end
end
function row = buildRow(id, label, V, delta, P, Q, baseMVA, packet_delay, packet_loss, glitchCount, nbus)
    varNames = {'SampleID','Label'};
    vals = {id, label};
    for b = 1:nbus
        varNames{end+1} = sprintf('Bus%d_V', b); vals{end+1} = V(b); %#ok<AGROW>
    end
    for b = 1:nbus
        varNames{end+1} = sprintf('Bus%d_Angle', b); vals{end+1} = rad2deg(delta(b)); %#ok<AGROW>
    end
    for b = 1:nbus
        varNames{end+1} = sprintf('Bus%d_P', b); vals{end+1} = P(b)*baseMVA; %#ok<AGROW>
    end
    for b = 1:nbus
        varNames{end+1} = sprintf('Bus%d_Q', b); vals{end+1} = Q(b)*baseMVA; %#ok<AGROW>
    end
    varNames = [varNames, {'Packet_Delay','Packet_Loss','GlitchCount'}];
    vals = [vals, {packet_delay, packet_loss, glitchCount}];
    row = table(vals{:}, 'VariableNames', varNames);
end
